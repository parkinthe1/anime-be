# คัดลอกเป็น .env แล้วแก้ค่า (ไฟล์ .env ห้าม commit)
# บน Render ให้ตั้งค่าเหล่านี้ที่ Environment แทน

# Supabase: Project Settings > Database > Connection string > "Session pooler" (พอร์ต 5432)
# Render ใช้ IPv4 ต้องใช้ pooler ไม่ใช่ direct connection / ถ้ารหัสผ่านมีอักขระพิเศษต้อง URL-encode
DATABASE_URL=postgresql://postgres.xxxxxxxx:รหัสผ่าน@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# สุ่มข้อความยาว ๆ อย่างน้อย 32 ตัว เช่น  openssl rand -hex 32
JWT_SECRET=

# origin ของหน้าเว็บที่อนุญาต คั่นด้วยจุลภาค (ใส่ https://*.vercel.app ได้ เพื่อรองรับ preview deploy)
CORS_ORIGINS=http://localhost:3000,https://ชื่อทีม.vercel.app

# ไม่บังคับ: ถ้าใส่ทั้งคู่ ตอนเปิด server จะสร้างบัญชี admin ให้ถ้ายังไม่มี (ไม่ต้องเก็บรหัสผ่าน admin ในโค้ด)
ADMIN_EMAIL=admin@aniwave.test
ADMIN_PASSWORD=

# Render ตั้ง PORT ให้เอง ในเครื่องใช้ค่าเริ่มต้น 8080
# ถ้าอยากใช้กับ FE โดยไม่แก้อะไร (proxy ของ CRA ชี้พอร์ต 4000) ให้ตั้ง PORT=4000
PORT=8080
